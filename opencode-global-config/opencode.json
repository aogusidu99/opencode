{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "edit": {
      "*": "ask",
      "**": "allow",
      "*.lock": "ask",
      "*.lockb": "ask",
      "*lock*": "ask",
      "pnpm-lock.yaml": "ask",
      ".env*": "ask",
      ".git/**": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "ask",
      "rm -fr*": "ask",
      "*Remove-Item* -Recurse* -Force*": "ask",
      "sudo*": "ask",
      "git push origin main*": "ask",
      "npm publish*": "ask",
      "docker push*": "ask",
      "*deploy*": "ask",
      "*prod*": "ask",
      "aws*": "ask",
      "vercel*": "ask",
      "git reset --hard*": "ask",
      "git checkout --*": "ask"
    },
    "external_directory": "allow"
  },
  "mcp": {
    "gdrive": {
      "type": "local",
      "command": ["npx", "-y", "@hachiai/mcp-google-drive"],
      "enabled": true,
      "environment": {
        "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "C:\\Users\\aogus\\.config\\mcp-google-drive\\gcp-oauth.keys.json",
        "GOOGLE_DRIVE_MCP_TOKEN_PATH": "C:\\Users\\aogus\\.config\\mcp-google-drive\\tokens.json"
      }
    },
    "gmail": {
      "type": "local",
      "command": ["npx", "-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "enabled": true,
      "environment": {
        "GMAIL_OAUTH_PATH": "C:\\Users\\aogus\\.gmail-mcp\\gcp-oauth.keys.json",
        "GMAIL_CREDENTIALS_PATH": "C:\\Users\\aogus\\.gmail-mcp\\credentials.json"
      }
    },
    "gcalendar": {
      "type": "local",
      "command": ["npx", "-y", "@cocal/google-calendar-mcp"],
      "enabled": true,
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "C:\\Users\\aogus\\.config\\mcp-google-drive\\gcp-oauth.keys.json",
        "GOOGLE_CALENDAR_MCP_TOKEN_PATH": "C:\\Users\\aogus\\.config\\mcp-google-drive\\tokens.json"
      }
    },
    "gemini-search": {
      "type": "local",
      "command": ["node", "D:\\Code\\opencode\\opencode-global-config\\mcp-scripts\\gemini-search\\server.mjs"],
      "enabled": true
    }
  }
}
