{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "edit": {
      "*": "ask",
      "*.lock": "deny",
      "*.lockb": "deny",
      "pnpm-lock.yaml": "deny",
      ".env*": "deny",
      ".git/**": "deny"
    },
    "read": "allow",
    "external_directory": "allow"
  }
}
