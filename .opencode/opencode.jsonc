{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    "edit": {
      "*": "ask",
      "**": "allow",
      "packages/opencode/migration/*": "deny",
    },
    "external_directory": "allow",
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "skills": {
    "paths": [".opencode/skills"],
  },
  "plugin": [
    ".opencode/plugins/hooks-logger.js",
  ],
}
